{
  "name": "grocky",
  "version": "0.2.0",
  "description": "Desktop GUI for Grok Build CLI — Claude Code-style app over ACP",
  "main": "out/main/index.js",
  "author": "Grocky",
  "license": "MIT",
  "private": true,
  "scripts": {
    "safe-install": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/safe-npm-install.ps1",
    "security-check": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/check-deps-security.ps1",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/ts-loader.mjs \"tests/*.test.ts\"",
    "verify": "npm run typecheck && npm test",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@vitejs/plugin-react": "4.4.1",
    "electron": "36.4.0",
    "electron-builder": "26.0.12",
    "electron-vite": "3.1.0",
    "typescript": "5.8.3",
    "vite": "6.3.3"
  },
  "build": {
    "appId": "com.grocky.app",
    "productName": "Grocky",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"],
      "hardenedRuntime": true
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development"
    }
  }
}
