# Supply-chain hardening (Shai-Hulud / worm era)
# Prefer:  .\scripts\safe-npm-install.ps1
# which installs with --ignore-scripts, scans, then installs Electron binary only.

# Never auto-run funding noise; keep installs quieter for review.
fund=false

# Prefer lockfile when present
package-lock=true

# Do NOT set ignore-scripts=true here permanently — Electron needs a controlled
# post-step. Use scripts/safe-npm-install.ps1 instead of bare `npm install`.
